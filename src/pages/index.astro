---
import { localePath } from '~/i18n';
import BrandFonts from '~/components/common/BrandFonts.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>时咨月圆 / Shea</title>
    <BrandFonts />
    <CustomStyles />
    <ClientRouter fallback="swap" />
    <style>
      :root {
        color-scheme: light dark;
        font-family: var(--aw-font-sans);
      }
      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
      }
      main {
        padding: 2rem;
      }
      nav {
        display: flex;
        gap: 1.5rem;
      }
      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <main data-locale-entry>
      <h1>时咨月圆 / Shea</h1>
      <nav aria-label="语言 / Language / 言語">
        <a href={localePath('zh')} lang="zh-Hans">进入中文桌面</a>
        <a href={localePath('en')} lang="en">Enter in English</a>
        <a href={localePath('ja')} lang="ja">日本語で開く</a>
      </nav>
    </main>
    <script>
      import { resolveLocale, localePath } from '~/i18n';
      import { navigate } from 'astro:transitions/client';
      document.addEventListener('astro:page-load', () => {
        if (!document.querySelector('[data-locale-entry]')) return;
        let saved: string | null = null;
        try {
          saved = localStorage.getItem('shea-locale');
        } catch {
          /* Storage is optional. */
        }
        const locale = resolveLocale(navigator.languages ?? [navigator.language], saved);
        void navigate(`${localePath(locale)}${location.search}${location.hash}`, { history: 'replace' });
      });
    </script>
  </body>
</html>
