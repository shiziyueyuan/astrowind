---
import DesktopLayout from '~/layouts/DesktopLayout.astro';
import DesktopHeader from '~/components/desktop/DesktopHeader.astro';
import { localePath } from '~/i18n';
import '~/assets/styles/journal.css';
---

<DesktopLayout locale="zh" title="404 · 这扇窗口还没有内容" indexable={false}>
  <div class="workspace journal-workspace">
    <DesktopHeader locale="zh" /><main class="journal-main">
      <a class="project-back mono" href={localePath('zh')}>↖ 返回桌面 / Back to desktop / デスクへ</a><header
        class="journal-heading"
      >
        <p class="eyebrow mono">404 / NOT FOUND</p><h1>这扇窗口还没有内容。</h1><p>
          This page could not be found. / ページが見つかりませんでした。
        </p>
      </header>
    </main>
  </div>
</DesktopLayout>
