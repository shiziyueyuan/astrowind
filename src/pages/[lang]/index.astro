---
import Desktop from '~/components/desktop/Desktop.astro';
import DesktopLayout from '~/layouts/DesktopLayout.astro';
import { locales, type Locale } from '~/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<DesktopLayout locale={locale} desktop><Desktop locale={locale} /></DesktopLayout>
