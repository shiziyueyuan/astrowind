---
import { languageNames, localePath, locales, type Locale } from '~/i18n';
import { dictionaries } from '~/i18n/dictionaries';
import SheaWordmark from '~/assets/brand/shea-wordmark.svg';
import SoundControls from './SoundControls.astro';
import { legalCopy } from '~/i18n/legal';
interface Props {
  locale: Locale;
  pathSuffix?: string;
}
const { locale, pathSuffix = '' } = Astro.props;
const copy = dictionaries[locale];
---

<header class="desktop-header">
  <a class="wordmark" href={localePath(locale)} aria-label="Shea / 时咨月圆">
    <svg class="wordmark-emblem" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
      <path d="M2 2h14v14H2zm14 14h14v14H16z" fill="currentColor"></path>
      <path d="M30 2a14 14 0 0 1-14 14V2zM2 30a14 14 0 0 1 14-14v14z" fill="currentColor"></path>
    </svg>
    <SheaWordmark class="shea-lettering" aria-hidden="true" />
  </a>
  <span class="workspace-label">{copy.workspace}</span>
  <div class="header-controls">
    <nav class="language-switch" aria-label={copy.language}>
      {
        locales.map((language) => (
          <a
            href={`${localePath(language)}${pathSuffix}`}
            lang={language}
            data-locale={language}
            aria-current={language === locale ? 'page' : undefined}
          >
            {languageNames[language]}
          </a>
        ))
      }
    </nav>
    <span class="control-divider" aria-hidden="true"></span>
    <label class="theme-control">
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"></path>
      </svg>
      <span class="sr-only">{copy.theme}</span>
      <select id="theme-select" aria-label={copy.theme}>
        <option value="system">{copy.themes.system}</option>
        <option value="light">{copy.themes.light}</option>
        <option value="dark">{copy.themes.dark}</option>
      </select>
    </label>
    <SoundControls locale={locale} />
    <a
      class="header-legal"
      href={`${localePath(locale)}/legal`}
      aria-label={legalCopy[locale].title}
      title={legalCopy[locale].title}
    >
      <span aria-hidden="true">§</span><span class="header-legal-label">{legalCopy[locale].label}</span>
    </a>
  </div>
  <slot name="status" />
</header>

<style>
  .header-legal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 44px;
    color: var(--desk-muted);
    font-size: 10px;
    white-space: nowrap;
  }
  .header-legal:hover {
    color: var(--desk-ink);
  }
  .header-legal > span:first-child {
    font-size: 16px;
  }
  @media (max-width: 700px) {
    :global(.shea-desktop) .desktop-header {
      gap: 8px;
    }
    .desktop-header .header-controls {
      gap: 7px;
    }
    .desktop-header .wordmark > .shea-lettering {
      width: 68px;
    }
    .desktop-header .language-switch {
      gap: 8px;
      font-size: 9px;
    }
    .desktop-header .theme-control svg {
      display: none;
    }
    .header-legal-label {
      display: none;
    }
    .header-legal {
      min-width: 24px;
    }
  }
  @media (max-width: 370px) {
    .desktop-header .wordmark-emblem {
      display: none;
    }
    .desktop-header .header-controls {
      gap: 5px;
    }
  }
</style>
