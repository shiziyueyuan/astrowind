---
import type { RegionId } from '~/i18n/dictionaries';
interface Props {
  region: RegionId;
}
const { region } = Astro.props;
---

<svg class={`os-app-art os-app-${region}`} viewBox="0 0 64 64" width="64" height="64" fill="none" aria-hidden="true">
  {
    region === 'entry' && (
      <>
        <rect class="app-plate" x="6" y="10" width="52" height="44" rx="9" />
        <>
          <path class="app-rule" d="M7 21H57" />
          <circle class="app-detail" cx="14" cy="16" r="1.5" />
          <circle class="app-detail" cx="20" cy="16" r="1.5" />
        </>
        <path class="app-glyph" d="M17 30L24 36L17 42M31 43H44" />
      </>
    )
  }
  {
    region === 'identity' && (
      <>
        <path class="app-plate" d="M16 6H39L51 18V53A5 5 0 0 1 46 58H16A5 5 0 0 1 11 53V11A5 5 0 0 1 16 6Z" />
        <>
          <path class="app-rule" d="M39 7V18H50" />
          <circle class="app-glyph" cx="30" cy="31" r="6" />
        </>
        <path class="app-glyph" d="M20 49C20 37 40 37 40 49" />
      </>
    )
  }
  {
    region === 'archive' && (
      <>
        <path class="app-folder-back" d="M7 17A5 5 0 0 1 12 12H26L32 18H52A5 5 0 0 1 57 23V48H7Z" />
        <path class="app-plate" d="M6 29A5 5 0 0 1 11 24H54A4 4 0 0 1 58 29L54 50A5 5 0 0 1 49 54H13A5 5 0 0 1 8 50Z" />
        <path class="app-glyph" d="M25 38H39M25 44H34" />
      </>
    )
  }
  {
    region === 'lab' && (
      <>
        <rect class="app-plate" x="7" y="7" width="50" height="50" rx="12" />
        <path class="app-glyph" d="M25 17H39M28 18V29L18 45Q16 49 21 49H43Q48 49 46 45L36 29V18M24 37H40" />
        <>
          <circle class="app-detail" cx="28" cy="43" r="2" />
          <circle class="app-detail" cx="35" cy="40" r="1.5" />
        </>
      </>
    )
  }
  {
    region === 'signal' && (
      <>
        <rect class="app-plate" x="5" y="14" width="54" height="38" rx="9" />
        <path class="app-glyph" d="M9 19L29 35Q32 38 35 35L55 19M8 48L23 35M56 48L41 35" />
        <>
          <circle class="app-badge" cx="52" cy="15" r="7" />
          <path class="app-badge-glyph" d="M49 15H55M52 12V18" />
        </>
      </>
    )
  }
</svg>
