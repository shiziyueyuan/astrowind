---
import { getCollection } from 'astro:content';
import { localePath, type Locale } from '~/i18n';
import '~/assets/styles/desktop-shell.css';
import { shellCopy } from '~/i18n/shell';
import DesktopIcon from './DesktopIcon.astro';
import BootSequence from './BootSequence.astro';
import DesktopHeader from './DesktopHeader.astro';
import ProjectCard from '~/components/archive/ProjectCard.astro';
import { dictionaries, regionIds } from '~/i18n/dictionaries';
import SheaWordmark from '~/assets/brand/shea-wordmark.svg';
import ContactTerminal from './ContactTerminal.astro';
import JournalList from './JournalList.astro';
import { journalForLocale } from '~/utils/journal';
import { journalCopy } from '~/i18n/journal';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = dictionaries[locale];
const shell = shellCopy[locale];
const journalPosts = await journalForLocale(locale);
const projects = (await getCollection('project', ({ data }) => !data.draft && data.locale === locale)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<div class="desktop-environment" data-desktop-surface>
  <a class="skip-link" href="#explore">{copy.skip}</a>
  <div class="workspace os-desktop" data-locale-name={locale}>
    <DesktopHeader locale={locale}>
      <time slot="status" class="os-clock mono" data-desktop-clock aria-label={shell.clock}>—:—</time>
    </DesktopHeader>
    <main class="os-canvas" id="main-content" aria-labelledby="desktop-title">
      <nav class="os-launchers" id="explore" aria-label={copy.navigation}>
        {
          regionIds.map((region, index) => (
            <button
              type="button"
              class="os-icon"
              style={`--app-index: ${index}`}
              data-open-window={region}
              aria-haspopup="dialog"
              aria-controls={`window-${region}`}
              aria-expanded="false"
            >
              <span class="os-open-dot" aria-hidden="true" />
              <DesktopIcon region={region} />
              <span class="os-icon-name mono">{region.toUpperCase()}</span>
              <span class="os-icon-label">{copy.regions[region].label}</span>
            </button>
          ))
        }
      </nav>
      <section class="os-wallpaper" aria-labelledby="desktop-title">
        <svg class="os-wallpaper-art" viewBox="0 0 520 520" fill="currentColor" aria-hidden="true">
          <rect x="44" y="44" width="216" height="216" rx="5"></rect>
          <path d="M276 44H476A216 216 0 0 1 276 260Z"></path>
          <path d="M44 476A216 216 0 0 1 260 276V476Z"></path>
          <rect x="276" y="276" width="200" height="200" rx="5"></rect>
        </svg>
        <p class="os-system-name" aria-hidden="true"><SheaWordmark class="shea-lettering" /></p>
        <h1 id="desktop-title">{copy.headline[0]}{locale === 'en' ? ' ' : ''}{copy.headline[1]}</h1>
        <p class="os-identity">{shell.identity}</p>
        <p class="os-wallpaper-hint">{shell.launchHint}<span aria-hidden="true">↖</span></p>
      </section>
      <aside class="os-side" aria-label={shell.readme}>
        <section class="os-welcome" aria-labelledby="welcome-title">
          <div class="os-note-bar mono"><span>READ ME.txt</span><span aria-hidden="true">⌁</span></div>
          <div class="os-note-content">
            <h2 id="welcome-title">{shell.welcome}</h2><p>{copy.introduction}</p><p>{shell.note}</p>
          </div>
        </section>
        <section class="os-files" aria-labelledby="on-desk-title">
          <h2 id="on-desk-title" class="os-files-heading mono">
            <span>{shell.onDesk}</span><span aria-hidden="true">↙</span>
          </h2>
          <div class="os-project-files">
            {
              projects.map((project) => (
                <a class="os-file" href={`${localePath(locale)}/archive/${project.data.translationKey}`}>
                  <span class="os-file-mark" aria-hidden="true">
                    {project.data.video ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="M10 9L16 12L10 15Z" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                        <path d="M3 18Q12 1 21 18M3 18H21M12 6V18" />
                      </svg>
                    )}
                  </span>
                  <span class="os-file-info">
                    <>
                      <span class="os-file-title">{project.data.title}</span>
                      <span class="os-file-kind mono">
                        {project.data.category} / {project.data.video ? 'FILM' : 'NOTE'}
                      </span>
                    </>
                  </span>
                  <span class="os-file-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ))
            }
          </div>
        </section>
      </aside>
    </main>
    <footer class="os-taskbar">
      <div class="os-task-status">
        <span class="status-dot" aria-hidden="true"></span><span
          data-window-status
          data-empty={shell.systemReady}
          data-count-label={shell.openWindows}>{shell.systemReady}</span
        >
      </div>
      <nav class="os-dock" aria-label={shell.dock}>
        {
          regionIds.map((region) => (
            <button
              type="button"
              class="os-dock-item"
              data-open-window={region}
              aria-label={`${region.toUpperCase()} · ${copy.regions[region].label}`}
              aria-haspopup="dialog"
              aria-controls={`window-${region}`}
              aria-expanded="false"
            >
              <>
                <DesktopIcon region={region} />
                <span class="os-dock-tooltip" aria-hidden="true">
                  {copy.regions[region].label}
                </span>
              </>
            </button>
          ))
        }
      </nav>
      <div class="os-task-actions">
        <button type="button" data-arrange-windows aria-label={copy.arrangeWindows}
          ><span aria-hidden="true">▦</span><span class="os-action-label">{copy.arrangeWindows}</span></button
        >
        <button type="button" data-replay-intro aria-label={shell.replay}
          ><span aria-hidden="true">↻</span><span class="os-action-label">{shell.replay}</span></button
        >
      </div>
    </footer>
  </div>
  <p id="window-move-help" class="sr-only">{copy.windowMoveHelp}</p>

  {
    regionIds.map((region, index) => (
      <dialog
        class="desktop-window"
        id={`window-${region}`}
        data-region={region}
        aria-modal="false"
        aria-labelledby={`title-${region}`}
      >
        <div class="window-titlebar">
          <button
            type="button"
            class="window-drag-handle mono"
            data-drag-window
            aria-label={copy.windowMove + ': ' + copy.regions[region].label}
            aria-describedby="window-move-help"
          >
            <svg class="window-grip" width="12" height="18" viewBox="0 0 12 18" fill="currentColor" aria-hidden="true">
              <>
                <circle cx="3" cy="4" r="1" />
                <circle cx="9" cy="4" r="1" />
                <circle cx="3" cy="9" r="1" />
                <circle cx="9" cy="9" r="1" />
                <circle cx="3" cy="14" r="1" />
                <circle cx="9" cy="14" r="1" />
              </>
            </svg>
            <span>
              0{index + 1} / {region.toUpperCase()}
            </span>
          </button>
          <button type="button" class="window-close" data-close-window aria-label={copy.close}>
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="window-body">
          <p class="eyebrow mono">{copy.regions[region].label}</p>
          <h2 id={`title-${region}`} tabindex="-1">
            {copy.regions[region].title}
          </h2>
          <p class="window-description">{copy.regions[region].body}</p>
          {region === 'identity' && (
            <div class="role-list">
              {copy.roles.map((role) => (
                <span>{role}</span>
              ))}
            </div>
          )}
          {region === 'archive' ? (
            <div class="archive-projects">
              {projects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          ) : region === 'signal' ? (
            <ContactTerminal locale={locale} />
          ) : region === 'lab' ? (
            <>
              <JournalList posts={journalPosts} locale={locale} compact />
              <p class="journal-readonly mono">{journalCopy[locale].readOnly}</p>
              <div class="archive-projects">
                {projects
                  .filter((project) => project.data.video)
                  .map((project) => (
                    <ProjectCard project={project} />
                  ))}
              </div>
            </>
          ) : (
            <>
              <ul class="window-items">
                {copy.regions[region].items.map((item) => (
                  <li>
                    <span aria-hidden="true">↗</span>
                    {item}
                  </li>
                ))}
              </ul>
            </>
          )}
          <p class="window-note">
            <span class="status-dot" />
            {copy.regions[region].note}
          </p>
        </div>
        <div class="window-status mono">
          <>
            <span>SHEA / {region.toUpperCase()}</span>
            <span>{copy.windowMoveHint}</span>
          </>
        </div>
      </dialog>
    ))
  }
</div>
<BootSequence locale={locale} />
<script>
  import { initDesktop } from './desktop-controller';
  import { initDesktopIntro } from './desktop-intro';
  initDesktop();
  const surface = document.querySelector<HTMLElement>('[data-desktop-surface]');
  if (surface) initDesktopIntro(surface);
</script>
