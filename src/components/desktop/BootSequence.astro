---
import type { Locale } from '~/i18n';
import { shellCopy } from '~/i18n/shell';
import SheaWordmark from '~/assets/brand/shea-wordmark.svg';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = shellCopy[locale];
---

<section
  class="boot-screen"
  data-boot-screen
  data-phase="0"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="boot-title"
  tabindex="-1"
>
  <div class="boot-corner mono" aria-hidden="true"><span>SHEA / PERSONAL WORKSPACE</span><span>01 — ENTER</span></div>
  <div class="boot-center">
    <div class="boot-emblem" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <p class="boot-wordmark"><SheaWordmark class="shea-lettering" /></p>
    <h2 id="boot-title">{copy.bootTitle}</h2>
    <div class="boot-track" aria-hidden="true"><span></span></div>
    <div class="boot-steps mono" aria-hidden="true">
      {
        copy.bootSteps.map((step, index) => (
          <p data-boot-step={index}>
            <span>0{index + 1}</span>
            {step}
          </p>
        ))
      }
    </div>
  </div>
  <footer class="boot-footer">
    <span class="mono">时咨月圆 / Shea</span><button type="button" data-skip-intro
      >{copy.skip}<span aria-hidden="true"> ↗</span></button
    >
  </footer>
</section>
