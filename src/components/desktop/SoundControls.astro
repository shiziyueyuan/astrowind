---
import { localePath, type Locale } from '~/i18n';
import { audioCopy } from '~/i18n/audio';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = audioCopy[locale];
---

<details class="sound-controls" data-sound-controls data-copy={JSON.stringify(copy)}>
  <summary aria-label={copy.label} title={copy.label}>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M11 5L6 9H3V15H6L11 19Z"></path>
      <path class="sound-waves" d="M15 8Q20 12 15 16M18 5Q26 12 18 19"></path>
      <path class="sound-slash" d="M15 9L21 15M21 9L15 15"></path>
    </svg>
    <span class="sound-label">{copy.label}</span>
    <span class="sound-dot" aria-hidden="true"></span>
  </summary>
  <section class="sound-panel" aria-label={copy.title}>
    <p class="sound-title">{copy.title}</p>
    <p class="sound-description">{copy.description}</p>
    <button class="sound-power" type="button" data-sound-power aria-pressed="false" disabled>{copy.start}</button>
    <label class="sound-option"
      ><span>{copy.music}</span><input type="checkbox" data-sound-music checked disabled /></label
    >
    <label class="sound-option"
      ><span>{copy.effects}</span><input type="checkbox" data-sound-effects checked disabled /></label
    >
    <label class="sound-volume"
      ><span>{copy.volume} <output data-sound-volume-value>28%</output></span><input
        type="range"
        min="0"
        max="100"
        step="1"
        value="28"
        data-sound-volume
        disabled
      /></label
    >
    <p class="sound-status" data-sound-status role="status" aria-live="polite">{copy.off}</p>
    <p class="sound-hint">{copy.hint}</p>
    <a class="sound-source" href={`${localePath(locale)}/legal#sound`}>{copy.source} ↗</a>
  </section>
</details>
<style>
  .sound-controls {
    position: relative;
    font-size: 10px;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 4px;
  }
  .sound-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--desk-muted);
  }
  .sound-waves {
    display: none;
  }
  [data-active='true'] .sound-waves {
    display: block;
  }
  [data-active='true'] .sound-slash {
    display: none;
  }
  [data-active='true'] .sound-dot {
    background: var(--desk-accent);
    box-shadow: 0 0 0 2px var(--desk-accent-ink);
  }
  .sound-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 120;
    width: min(300px, calc(100vw - 32px));
    max-height: min(520px, calc(100svh - 90px));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 23px;
    border: 1px solid var(--desk-line);
    background: var(--desk-paper);
    box-shadow: var(--desk-shadow);
    color: var(--desk-ink);
  }
  .sound-title {
    margin: 0 0 9px;
    font-size: 17px;
    font-weight: 600;
  }
  .sound-description,
  .sound-hint {
    color: var(--desk-muted);
    font-size: 11px;
    line-height: 1.8;
    margin: 0 0 16px;
  }
  .sound-power {
    display: block;
    width: 100%;
    border: 1px solid var(--desk-line);
    padding: 11px;
    margin: 0 0 13px;
    background: var(--desk-accent);
    color: var(--desk-accent-ink);
    font-size: 12px;
  }
  .sound-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 39px;
    font-size: 12px;
    cursor: pointer;
  }
  .sound-option input {
    width: 16px;
    height: 16px;
    accent-color: var(--desk-accent-ink);
  }
  :global(.dark) .sound-option input {
    accent-color: var(--desk-accent);
  }
  .sound-volume {
    display: block;
    margin: 11px 0 0;
    font-size: 11px;
  }
  .sound-volume > span {
    display: flex;
    justify-content: space-between;
  }
  .sound-volume input {
    display: block;
    width: 100%;
    min-height: 36px;
    accent-color: var(--desk-ink);
  }
  .sound-status {
    font-size: 11px;
    margin: 8px 0 12px;
  }
  .sound-hint {
    font-size: 10px;
    margin-bottom: 14px;
  }
  .sound-source {
    display: inline-block;
    padding: 5px 0;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: 10px;
  }
  @media (max-width: 700px) {
    .sound-label,
    .sound-dot {
      display: none;
    }
    summary {
      justify-content: center;
      min-width: 30px;
    }
    .sound-panel {
      right: -30px;
    }
  }
</style>
