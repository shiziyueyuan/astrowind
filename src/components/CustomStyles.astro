---
// Theme variables shared by AstroWind and the Shea desktop foundation.
---

<style is:inline>
  :root {
    --shea-cjk: var(--font-wenkai), var(--font-klee-one);
    --shea-body-weight: 500;
    --aw-font-sans: var(--font-space-grotesk), var(--shea-cjk), sans-serif;
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);
    --shea-font-mono: var(--font-space-mono), var(--shea-cjk), monospace;
    --aw-color-primary: rgb(40 78 50);
    --aw-color-secondary: rgb(29 51 40);
    --aw-color-accent: rgb(40 78 50);
    --aw-color-text-heading: rgb(29 43 34);
    --aw-color-text-default: rgb(29 43 34);
    --aw-color-text-muted: rgb(94 107 97);
    --aw-color-bg-page: rgb(246 248 242);
    --aw-color-bg-page-dark: rgb(17 19 15);
  }

  :root:lang(en) {
    --shea-body-weight: 400;
  }

  :root:lang(ja) {
    --shea-cjk: var(--font-klee-one), var(--font-wenkai);
    --shea-body-weight: 400;
  }

  [lang]:lang(zh) {
    font-family: var(--font-space-grotesk), var(--font-wenkai), var(--font-klee-one), sans-serif;
  }

  [lang]:lang(ja) {
    font-family: var(--font-space-grotesk), var(--font-klee-one), var(--font-wenkai), sans-serif;
  }

  .dark {
    --aw-color-primary: rgb(251 153 93);
    --aw-color-secondary: rgb(255 174 123);
    --aw-color-accent: rgb(251 153 93);
    --aw-color-text-heading: rgb(241 240 230);
    --aw-color-text-default: rgb(241 240 230);
    --aw-color-text-muted: rgb(165 175 161);
    --aw-color-bg-page: rgb(17 19 15);
  }
</style>
